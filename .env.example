# ── PostgreSQL ────────────────────────────────
POSTGRES_USER=decouple
POSTGRES_PASSWORD=decouple_secret
POSTGRES_DB=decouple_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret

# ── Anthropic ────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── GitHub (for repo ingestion via API) ──────
GITHUB_TOKEN=ghp_...

# ── Application ──────────────────────────────
APP_ENV=development
SECRET_KEY=change_me_to_a_long_random_string
ALLOWED_ORIGINS=http://localhost:3000

# ── Flower ────────────────────────────────────
FLOWER_USER=admin
FLOWER_PASSWORD=flower_secret

# ── Scratch space for cloned repos ───────────
REPO_SCRATCH_DIR=/tmp/decouple_repos
